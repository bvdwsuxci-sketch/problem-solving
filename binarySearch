#include <iostream>
#include <vector>
using namespace std;

int binarySearch(vector<int>& nums, int Left, int Right, int target) {
	if (Left > Right)
		return -1;



	int mid = Left + (Right - Left) / 2;

	if (nums[mid] == target) {
		return mid;
	}
	else if (nums[mid] > target) {
		binarySearch(nums, mid-1, Right, target);
	}
	else {
		binarySearch(nums, mid + 1, Right, target);
	}
	return binarySearch(nums, mid , Right, target);
}


int main()
{
	vector<int> nums = { {1},{3},{4},{5},{6},{8} };

	int target = 7;
	int Leght = 0;
	int Right = nums.size() - 1;
	

	if (binarySearch(nums, Leght, Right, target) != -1) {
		cout << "Exist";
	}
	else {
		cout << "Not Exist";
	}


	


}

