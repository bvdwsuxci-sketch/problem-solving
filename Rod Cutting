
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> price(n);

    for (int i = 0; i < n; i++) {
        cin >> price[i];
    }

    vector<int> dp(n + 1, 0);

    for (int length = 1; length <= n; length++) {
        for (int cut = 1; cut <= length; cut++) {
            dp[length] = max(dp[length],
                             price[cut - 1] + dp[length - cut]);
        }
    }

    cout << dp[n];

    return 0;
}
