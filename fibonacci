#include <iostream>
#include <vector>
using namespace std;

int fib(int n){
	
	if (n <= 1) return n;

	vector<int> fibb(n + 1);
	fibb[0] = 0;
	fibb[1] = 1;

	for (int i = 2; i <= n; i++) {
		fibb[i] = fib(i - 1) + fib(i - 2);
	}
	return fibb[n];
}

int main()
{

	int n = 4;
	int x= fib(n);
	cout << x;

}










#include <iostream>
#include <vector>
using namespace std;

    long  fib(int n, vector<long >& memo)
    {
        if (n <= 1)
            return n;
       

        if (memo[n] != -1)   // already computed
            return memo[n];

        memo[n] = fib(n - 1, memo) + fib(n - 2, memo);
        return memo[n];
    }

    int main()
    {
        int n = 5;
        vector<long> memo(n + 1, -1);

        cout << "Fibonacci of " << n << " = "
            << fib(n, memo) << endl;

        return 0;
    }
    















